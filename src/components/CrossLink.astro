---
// Renders one page.schema.json crossLink -- the only schema-legal way a
// section may name a sibling brand (RULE-CONTENT-PAGE-LEXICON-PROHIBITED-1
// exempts crossLinks from the bare-sibling-name check for exactly this
// reason: the relationshipLine is authored text stating the real
// relationship, not an incidental mention).
//
// Mark (2026-09-11, upgraded to VentureMark.astro same day): renders the
// referenced sibling's real animated mark when one has been pulled via
// luhtech-sync-animated-marks (today: JobsiteControl only), falling back
// to the static /brand/{brandRef}-mark.svg otherwise -- see
// VentureMark.astro's own comment for the full fallback chain, including
// why a missing file has to fail silently (not every consuming site
// carries every sibling's mark; e.g. ectropy.ai's own about.json cross-
// links to "luhtech" but has no luhtech-mark.svg locally, by design).
import VentureMark from './VentureMark.astro';

export interface Props {
	crossLink: { brandRef: string; relationshipLine: string; href: string };
}
const { crossLink } = Astro.props;
---
<a
	href={crossLink.href}
	class="block rounded-md border border-ink/15 p-4 hover:border-accent-primary transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent-primary"
>
	<VentureMark brandRef={crossLink.brandRef} />
	<span class="font-display font-semibold">{crossLink.brandRef}</span>
	<p class="text-sm text-ink/70 mt-1">{crossLink.relationshipLine}</p>
</a>
