---
// Single entry point for rendering a page.sections[] entry: dispatches on
// sectionKind to the matching sections/*.astro component. A consumer page
// just does {page.sections.map((s) => <Section section={s} site={site} />)}.
// site is optional and only actually used by the "cta" kind (to embed the
// real lead-capture form) -- passed through uniformly so a future
// sectionKind needing site-level data doesn't require a new prop plumbed
// through every call site again.
import Hero from './sections/Hero.astro';
import Problem from './sections/Problem.astro';
import Approach from './sections/Approach.astro';
import Proof from './sections/Proof.astro';
import Audiences from './sections/Audiences.astro';
import Open from './sections/Open.astro';
import Status from './sections/Status.astro';
import Sources from './sections/Sources.astro';
import Cta from './sections/Cta.astro';
import Legal from './sections/Legal.astro';
import Article from './sections/Article.astro';
import VentureCard from './VentureCard.astro';

const SECTION_COMPONENTS: Record<string, any> = {
	hero: Hero,
	problem: Problem,
	approach: Approach,
	proof: Proof,
	audiences: Audiences,
	open: Open,
	status: Status,
	sources: Sources,
	cta: Cta,
	legal: Legal,
	article: Article,
};

// icons is an optional, generic per-page mapping a consumer passes to opt a
// page into the shared line-icon set (Icon.astro) without page.schema.json
// growing an icon field -- the schema has no such field, and content
// instances can't carry one, so the mapping lives in the .astro caller
// (real venture vocabulary: block.label / sectionId -> a real ICONS key)
// and flows through here to whichever sections/*.astro component knows how
// to use it. Absent for a section kind that doesn't look at it -- a no-op,
// not an error.
export interface SectionIcons {
	/** sectionId -> icon name, for a section-level heading icon. */
	section?: Record<string, string>;
	/** block.label -> icon name, for a per-block icon (e.g. Audiences cards). */
	block?: Record<string, string>;
}

export interface Props {
	section: any;
	site?: any;
	companyLabel?: string;
	icons?: SectionIcons;
	// Passed through uniformly to whichever component actually looks at
	// them -- today only sectionKind:"article" (Article.astro) reads these,
	// for a real toolRef section rendering its resolved tool instance
	// (loaded once by the page caller via loadTool(), same pattern as
	// site/page themselves), same passthrough shape as `site` above.
	tool?: any;
	toolSubmitEndpoint?: string;
	route?: string;
	ventureRef?: string;
}
const { section, site, companyLabel, icons, tool, toolSubmitEndpoint, route, ventureRef } = Astro.props;
const Component = SECTION_COMPONENTS[section.sectionKind];
if (!Component) {
	throw new Error(`Section.astro: unknown sectionKind "${section.sectionKind}" (id: ${section.sectionId})`);
}
---
{section.sectionKind === 'cta' ? (
	<Cta section={section} leadCapture={site?.leadCapture} companyLabel={companyLabel} />
) : section.sectionKind === 'article' ? (
	<Component section={section} icons={icons} tool={tool} toolSubmitEndpoint={toolSubmitEndpoint} route={route} ventureRef={ventureRef} />
) : (
	<Component section={section} icons={icons} />
)}
{
	// crossLinks[] is schema-legal on any section kind (not sectionKind-
	// specific), so it renders once here rather than requiring every
	// individual sections/*.astro component to remember to. Found live:
	// about.json/insights.json's crossLinks entries (hero/proof kinds)
	// were silently invisible before this fix -- only Open.astro rendered
	// them. Open.astro's own inline rendering was removed to avoid a
	// double-render now that this is the single path.
	//
	// VentureCard (2026-09-12, supersedes the old bare CrossLink.astro):
	// mark to the left of a real display name (identity.name from the
	// venture's own brand.json via VENTURE_DIRECTORY), not the raw
	// brandRef slug stacked above it.
	section.crossLinks?.length > 0 && (
		<div class="grid gap-3 sm:grid-cols-2 mt-4" data-reveal>
			{section.crossLinks.map((cl: any) => <VentureCard crossLink={cl} />)}
		</div>
	)
}
