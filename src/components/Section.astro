---
// Single entry point for rendering a page.sections[] entry: dispatches on
// sectionKind to the matching sections/*.astro component. A consumer page
// just does {page.sections.map((s) => <Section section={s} site={site} />)}.
// site is optional and only actually used by the "cta" kind (to embed the
// real lead-capture form) -- passed through uniformly so a future
// sectionKind needing site-level data doesn't require a new prop plumbed
// through every call site again.
import Hero from './sections/Hero.astro';
import Problem from './sections/Problem.astro';
import Approach from './sections/Approach.astro';
import Proof from './sections/Proof.astro';
import Audiences from './sections/Audiences.astro';
import Open from './sections/Open.astro';
import Status from './sections/Status.astro';
import Sources from './sections/Sources.astro';
import Cta from './sections/Cta.astro';
import Legal from './sections/Legal.astro';

const SECTION_COMPONENTS: Record<string, any> = {
	hero: Hero,
	problem: Problem,
	approach: Approach,
	proof: Proof,
	audiences: Audiences,
	open: Open,
	status: Status,
	sources: Sources,
	cta: Cta,
	legal: Legal,
};

export interface Props {
	section: any;
	site?: any;
	companyLabel?: string;
}
const { section, site, companyLabel } = Astro.props;
const Component = SECTION_COMPONENTS[section.sectionKind];
if (!Component) {
	throw new Error(`Section.astro: unknown sectionKind "${section.sectionKind}" (id: ${section.sectionId})`);
}
---
{section.sectionKind === 'cta' ? (
	<Cta section={section} leadCapture={site?.leadCapture} companyLabel={companyLabel} />
) : (
	<Component section={section} />
)}
