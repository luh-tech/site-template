---
// d-2026-09-09-sr-page-diagrams-and-tool-schema. Real, build-time
// generated line chart from a real {x,y}[] dataset (replaces the source
// essay's own technique of hand-typing 439 coordinate pairs -- here the
// real dataset is passed as data and a real polyline is generated from
// it at build time, reusable for any future dataset-backed chart, not
// just the one it was first built for). Computed server-side (Astro
// frontmatter), matching RingComparison.astro's convention -- the data
// is fixed at author time, no client-side recomputation needed.
export interface Props {
	points: { x: number; y: number }[];
	xLabel?: string;
	yLabel?: string;
	annotations?: { x: number; y: number; label: string }[];
	class?: string;
}
const { points, xLabel, yLabel, annotations = [], class: className = 'w-full h-auto' } = Astro.props;

const W = 640;
const H = 280;
const PAD_L = 44;
const PAD_R = 16;
const PAD_T = 16;
const PAD_B = 36;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const xs = points.map((p) => p.x);
const ys = points.map((p) => p.y);
const minX = Math.min(...xs);
const maxX = Math.max(...xs);
const minY = Math.min(...ys, ...annotations.map((a) => a.y));
const maxY = Math.max(...ys, ...annotations.map((a) => a.y));
const xRange = maxX - minX || 1;
const yRange = maxY - minY || 1;

const sx = (x: number) => PAD_L + ((x - minX) / xRange) * plotW;
const sy = (y: number) => PAD_T + plotH - ((y - minY) / yRange) * plotH;

const polylinePoints = points.map((p) => `${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join(' ');
---
<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox={`0 0 ${W} ${H}`}
	class={className}
	role="img"
	aria-label={`Line chart of ${points.length} real data points${yLabel ? `, ${yLabel}` : ''}${xLabel ? ` over ${xLabel}` : ''}`}
>
	<line x1={PAD_L} y1={PAD_T} x2={PAD_L} y2={PAD_T + plotH} stroke="currentColor" stroke-opacity="0.2" />
	<line x1={PAD_L} y1={PAD_T + plotH} x2={PAD_L + plotW} y2={PAD_T + plotH} stroke="currentColor" stroke-opacity="0.2" />
	<polyline points={polylinePoints} fill="none" stroke="currentColor" class="text-accent-primary" stroke-width="1.75" />
	{annotations.map((a) => (
		<g>
			<circle cx={sx(a.x)} cy={sy(a.y)} r="3" class="text-accent-secondary" fill="currentColor" />
			<text x={sx(a.x)} y={sy(a.y) - 8} text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="currentColor" fill-opacity="0.7">{a.label}</text>
		</g>
	))}
	{yLabel && (
		<text x={PAD_L} y={12} font-family="JetBrains Mono, monospace" font-size="10" fill="currentColor" fill-opacity="0.5">{yLabel}</text>
	)}
	{xLabel && (
		<text x={PAD_L + plotW} y={H - 6} text-anchor="end" font-family="JetBrains Mono, monospace" font-size="10" fill="currentColor" fill-opacity="0.5">{xLabel}</text>
	)}
</svg>
