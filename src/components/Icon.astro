---
// ARC-GTM-SURFACE D2.2: shared line-icon grammar, backed by @lucide/astro
// (d-2026-09-09-sr-inline-diagram-image-blocks: replaced 26 hand-drawn inline
// SVGs with real Lucide components -- one real, maintained icon family behind
// the portfolio's whole icon surface instead of a hand-rolled set forked
// verbatim between this repo and LuhTech-Business). Registered brand-side as
// iconSetRef.iconSetId = "gtm-surface-line-icons-v1" -- a shared-set
// identifier (brand-identity schema's own alternative to a per-brand
// asset-bank upload), since this set is common across the portfolio rather
// than brand-specific.
//
// d-2026-09-09-sr-article-venture-routing-content-cells (LuhTech-Business
// build-out): this one file mixes truly portfolio-generic icons with
// Ectropy-specific ones. A consumer wiring Section's `icons` prop should
// only reach for the GENERIC subset unless it is genuinely a construction
// venture -- reaching for a construction icon on a non-construction site
// (e.g. LuhTech-Business, the holding/consultancy site) would be exactly
// the "borrowed Ectropy content" mistake this split exists to prevent.
//
// GENERIC (safe for any venture): location-pin, decision-chain, cost-tag,
// schema-doc, integration-plug, sync-loop, audit-trail, studio-compass,
// portfolio-grid, code-bracket, team-people, handshake, rocket, data-flow,
// mail-envelope, message-bubble, external-link, lock.
//
// CONSTRUCTION-SPECIFIC (Ectropy and other construction-venture sites
// only): voxel-grid, field-inspection, hard-hat, building, field-team,
// zone-map, change-order, crane.
//
// crane has no literal equivalent in Lucide's real catalog (confirmed
// against node_modules/@lucide/astro/src/icons -- no crane/tower-crane icon
// exists); hammer is the closest real, disclosed substitute, not a guess.
import { icons } from '@lucide/astro';

const ICONS: Record<string, keyof typeof icons> = {
	'voxel-grid': 'Boxes',
	'location-pin': 'MapPin',
	'decision-chain': 'GitBranch',
	'cost-tag': 'Tag',
	'field-inspection': 'ClipboardCheck',
	'schema-doc': 'FileCode',
	'integration-plug': 'Plug',
	'sync-loop': 'RefreshCw',
	'hard-hat': 'HardHat',
	'building': 'Building2',
	'field-team': 'Construction',
	'zone-map': 'Map',
	'audit-trail': 'ClipboardList',
	'change-order': 'FilePenLine',
	'studio-compass': 'Compass',
	'portfolio-grid': 'LayoutGrid',
	'code-bracket': 'Code',
	'team-people': 'Users',
	'crane': 'Hammer',
	'handshake': 'Handshake',
	'rocket': 'Rocket',
	'data-flow': 'Network',
	'mail-envelope': 'Mail',
	'message-bubble': 'MessageCircle',
	'external-link': 'ExternalLink',
	'lock': 'Lock',
};

export interface Props {
	/**
	 * A real ICONS key. Typed as string (not keyof typeof ICONS) because
	 * callers building a name from content data (block.label -> icon,
	 * see Section.astro's SectionIcons) can't statically narrow to the
	 * literal union -- an unknown name renders nothing rather than
	 * failing the build.
	 */
	name: string;
	class?: string;
}
const { name, class: className = 'w-6 h-6' } = Astro.props;
const lucideName = ICONS[name as keyof typeof ICONS];
const LucideIcon = lucideName ? icons[lucideName] : null;
---
{LucideIcon && (
	<LucideIcon
		class={className}
		stroke-width="1.75"
		aria-hidden="true"
	/>
)}
