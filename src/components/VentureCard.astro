---
// Renders one page.schema.json crossLink as a real card: mark to the left
// of the venture's real display name, sourced from its own canonical
// content/brand/{id}.json (identity.name) via VENTURE_DIRECTORY -- not the
// raw lowercase brandRef slug a crossLink carries (e.g. "jobsitecontrol").
// crossLink.relationshipLine stays as authored, page-specific free text
// (e.g. "the ADU platform we're building toward"), layered under the
// sourced name/oneLiner rather than replaced by it.
//
// Template-driven from source (2026-09-12, per Erik's direction): the
// name/oneLiner pairing is generated by
// bin/luhtech-sync-venture-directory.mjs, same convention as the mark
// itself -- one real source of truth (each venture's own brand.json),
// not hand-typed a second time per consuming site's crossLinks[] entry.
import VentureMark from './VentureMark.astro';
import { VENTURE_DIRECTORY } from '../lib/venture-directory.generated';

export interface Props {
	crossLink: { brandRef: string; relationshipLine: string; href: string };
}
const { crossLink } = Astro.props;
const directoryEntry = VENTURE_DIRECTORY[crossLink.brandRef];
const displayName = directoryEntry?.name ?? crossLink.brandRef;
// Several existing crossLinks[] instances (authored before this card
// sourced a real oneLiner) set relationshipLine to the venture's oneLiner
// verbatim -- rendering both would repeat the same sentence twice. Only
// show relationshipLine when it actually says something the sourced
// oneLiner doesn't.
const relationshipAddsInfo = crossLink.relationshipLine?.trim() !== directoryEntry?.oneLiner?.trim();
---
<a
	href={crossLink.href}
	class="flex items-start gap-3 rounded-md border border-ink/15 p-4 hover:border-accent-primary transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent-primary"
>
	<VentureMark brandRef={crossLink.brandRef} class="h-8 w-8 shrink-0" />
	<span class="min-w-0">
		<span class="block font-display font-semibold">{displayName}</span>
		{directoryEntry?.oneLiner && <span class="block text-xs text-ink/60 mt-0.5">{directoryEntry.oneLiner}</span>}
		{relationshipAddsInfo && <p class="text-sm text-ink/70 mt-1">{crossLink.relationshipLine}</p>}
	</span>
</a>
