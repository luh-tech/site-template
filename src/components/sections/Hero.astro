---
import Block from '../Block.astro';
import CtaLink from '../CtaLink.astro';
import SectionHeading from '../SectionHeading.astro';

export interface Props { section: any }
const { section } = Astro.props;
---
<section id={section.sectionId} class="py-8" data-reveal>
	<SectionHeading
		level="h1"
		eyebrow={section.eyebrow}
		heading={section.heading}
		subheading={section.subheading}
		headingClass="text-4xl sm:text-5xl leading-tight"
		subheadingClass="text-lg"
		class="mb-4"
	/>
	{section.blocks?.map((b: any) => <Block block={b} class="mb-3" />)}
	{section.ctas?.length > 0 && (
		<div class="mt-6 flex gap-4 flex-wrap">
			{section.ctas.map((c: any, i: number) => <CtaLink cta={c} variant={i === 0 ? 'primary' : 'secondary'} />)}
		</div>
	)}
</section>
