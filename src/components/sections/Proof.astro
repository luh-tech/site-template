---
// sectionKind: proof -- evidence: standards, published contracts, citations,
// and (only when a citable public record exists) customers/pilots/projects.
// claims[].text is the marketed-capability prose itself (the honesty rail
// that luhtech-page-claims enforces against real feature status); figures
// are cited, provenance.public numbers, never customer-use statements.
import Block from '../Block.astro';
import Figure from '../Figure.astro';
import Icon from '../Icon.astro';
import type { SectionIcons } from '../Section.astro';

export interface Props { section: any; icons?: SectionIcons }
const { section, icons } = Astro.props;
const sectionIcon = icons?.section?.[section.sectionId];

// Bio blocks (e.g. a Founders/Team proof section) read as an enterprise
// team grid -- side by side on desktop -- rather than stacked paragraphs.
// Contiguous runs of blockType:"bio" group into one grid; every other
// blockType renders individually, unchanged.
const blockRuns: { kind: 'bio' | 'other'; blocks: any[] }[] = [];
for (const b of section.blocks ?? []) {
	const kind = b.blockType === 'bio' ? 'bio' : 'other';
	const last = blockRuns[blockRuns.length - 1];
	if (last && last.kind === kind) last.blocks.push(b);
	else blockRuns.push({ kind, blocks: [b] });
}
---
<section id={section.sectionId} class="py-8" data-reveal>
	{section.eyebrow && <p class="text-sm font-mono uppercase tracking-wide text-accent-primary mb-3">{section.eyebrow}</p>}
	{sectionIcon && <Icon name={sectionIcon} class="w-8 h-8 text-accent-primary mb-3" />}
	{section.heading && <h2 class="font-display text-2xl font-bold mb-3">{section.heading}</h2>}
	{section.subheading && <p class="text-ink/80 max-w-2xl mb-4">{section.subheading}</p>}
	{blockRuns.map((run) =>
		run.kind === 'bio' ? (
			<div class="grid gap-4 sm:grid-cols-2 mb-3">
				{run.blocks.map((b) => <Block block={b} />)}
			</div>
		) : (
			run.blocks.map((b) => <Block block={b} class="mb-3" />)
		)
	)}
	{section.claims?.length > 0 && (
		<ul class="space-y-2 mb-6">
			{section.claims.map((c: any) => <li class="leading-relaxed">{c.text}</li>)}
		</ul>
	)}
	{section.figures?.length > 0 && (
		<div class="grid grid-cols-2 sm:grid-cols-3 gap-6 mt-4">
			{section.figures.map((f: any) => <Figure figure={f} />)}
		</div>
	)}
</section>
