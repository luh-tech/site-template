---
// sectionKind: audiences -- one block per buyer role. icons.block (keyed by
// block.label, see Section.astro's SectionIcons) is optional -- a consumer
// with a real per-role icon set opts in; without it every card renders
// exactly as before.
import Block from '../Block.astro';
import CtaLink from '../CtaLink.astro';
import Icon from '../Icon.astro';
import type { SectionIcons } from '../Section.astro';

export interface Props { section: any; icons?: SectionIcons }
const { section, icons } = Astro.props;
---
<section id={section.sectionId} class="py-8" data-reveal>
	{section.eyebrow && <p class="text-sm font-mono uppercase tracking-wide text-accent-primary mb-3">{section.eyebrow}</p>}
	{section.heading && <h2 class="font-display text-2xl font-bold mb-4">{section.heading}</h2>}
	<div class="grid gap-4 sm:grid-cols-2">
		{section.blocks?.map((b: any) => (
			<div class="rounded-md border border-ink/15 p-4">
				{icons?.block?.[b.label] && (
					<Icon name={icons.block[b.label]} class="w-7 h-7 text-accent-primary mb-2" />
				)}
				<Block block={b} />
			</div>
		))}
	</div>
	{section.ctas?.length > 0 && (
		<div class="mt-6 flex gap-4 flex-wrap">
			{section.ctas.map((c: any, i: number) => <CtaLink cta={c} variant={i === 0 ? 'primary' : 'secondary'} />)}
		</div>
	)}
</section>
