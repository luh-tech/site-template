---
// sectionKind: sources -- citations for every figure used on the page,
// each figure's provenance.sourceRef rendered as a full citation.
import SectionHeading from '../SectionHeading.astro';

export interface Props { section: any }
const { section } = Astro.props;
---
<section id={section.sectionId} class="py-8 border-t border-ink/10" data-reveal>
	<SectionHeading eyebrow={section.eyebrow} heading={section.heading} headingClass="text-xl" class="mb-4" />
	<ol class="space-y-2 text-sm text-ink/70">
		{section.figures?.map((f: any) => (
			<li>
				<strong>{f.value}{f.unit ? ` ${f.unit}` : ''}</strong> — {f.provenance.sourceRef}
				{f.provenance.observedAt && ` (observed ${f.provenance.observedAt})`}
			</li>
		))}
	</ol>
</section>
