---
// sectionKind: open -- open-standards/open-core statement. crossLinks
// (the schema-legal way a section names a sibling brand) render once,
// generically, for every sectionKind -- see Section.astro.
import Block from '../Block.astro';
import SectionHeading from '../SectionHeading.astro';
import type { SectionIcons } from '../Section.astro';

export interface Props { section: any; icons?: SectionIcons }
const { section, icons } = Astro.props;
const sectionIcon = icons?.section?.[section.sectionId];
---
<section id={section.sectionId} class="py-8" data-reveal>
	<SectionHeading eyebrow={section.eyebrow} heading={section.heading} subheading={section.subheading} icon={sectionIcon} />
	{section.blocks?.map((b: any) => <Block block={b} class="mb-3" />)}
</section>
