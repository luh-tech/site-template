---
// sectionKind: open -- open-standards/open-core statement. crossLinks are
// the schema-legal way this section names a sibling brand its openness
// connects to.
import Block from '../Block.astro';
import CrossLink from '../CrossLink.astro';

export interface Props { section: any }
const { section } = Astro.props;
---
<section id={section.sectionId} class="py-8" data-reveal>
	{section.eyebrow && <p class="text-sm font-mono uppercase tracking-wide text-accent-primary mb-3">{section.eyebrow}</p>}
	{section.heading && <h2 class="font-display text-2xl font-bold mb-3">{section.heading}</h2>}
	{section.subheading && <p class="text-ink/80 max-w-2xl mb-4">{section.subheading}</p>}
	{section.blocks?.map((b: any) => <Block block={b} class="mb-3" />)}
	{section.crossLinks?.length > 0 && (
		<div class="grid gap-3 sm:grid-cols-2 mt-4">
			{section.crossLinks.map((cl: any) => <CrossLink crossLink={cl} />)}
		</div>
	)}
</section>
