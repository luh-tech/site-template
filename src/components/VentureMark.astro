---
// Renders a venture's real mark on a sibling site (CrossLink.astro's own
// use case: luh.tech's Ventures page showing every real venture). Prefers
// the venture's own real animated mark (a self-contained .svg -- own
// scoped <style> with uniquely class-prefixed keyframes, so multiple
// ventures' marks can be inlined on the same page without one venture's
// animation overriding another's, e.g. a shared "logo-cell-in" name
// colliding across ventures) once pulled into VENTURE_MARKS via
// bin/luhtech-sync-animated-marks.mjs; falls back to the static
// /brand/{brandRef}-mark.svg file (onerror-hidden if even that's missing)
// for every venture that doesn't have one yet. Not every venture needs an
// animated mark for this to work; it degrades honestly per-venture
// instead of assuming universal coverage.
import { VENTURE_MARKS } from '../lib/venture-marks.generated';

export interface Props {
	brandRef: string;
	class?: string;
}
const { brandRef, class: className = 'h-6 w-6 mb-2' } = Astro.props;
const animated = VENTURE_MARKS[brandRef];
---
{animated ? (
	<svg xmlns="http://www.w3.org/2000/svg" viewBox={animated.viewBox} class={className} role="img" aria-label={brandRef} set:html={animated.markup} />
) : (
	<img
		src={`/brand/${brandRef}-mark.svg`}
		alt=""
		class={className}
		loading="lazy"
		onerror="this.style.display='none'"
	/>
)}
