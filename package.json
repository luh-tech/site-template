{
  "name": "@luhtech/site-template",
  "version": "0.18.0",
  "description": "Shared Astro component library + content-instance contract for LuhTech venture marketing sites -- one template renders every site from content/page.schema.json + content/site.schema.json instances.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "LuhTech Holdings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luh-tech/site-template.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./content": "./src/content/index.ts",
    "./lib/paperLanding": "./src/lib/paperLanding.ts",
    "./layouts/SiteLayout.astro": "./src/layouts/SiteLayout.astro",
    "./components/*": "./src/components/*",
    "./components/sections/*": "./src/components/sections/*"
  },
  "bin": {
    "luhtech-tokens": "bin/luhtech-tokens.mjs",
    "luhtech-page-lexicon": "bin/luhtech-page-lexicon.mjs",
    "luhtech-page-claims": "bin/luhtech-page-claims.mjs",
    "luhtech-sync-marks": "bin/luhtech-sync-marks.mjs",
    "luhtech-sync-animated-marks": "bin/luhtech-sync-animated-marks.mjs",
    "luhtech-sync-venture-directory": "bin/luhtech-sync-venture-directory.mjs",
    "luhtech-sync-icons": "bin/luhtech-sync-icons.mjs",
    "luhtech-seo-check": "bin/luhtech-seo-check.mjs"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "peerDependencies": {
    "astro": "^7.2",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@lucide/astro": "^1.42.0",
    "@resvg/resvg-js": "^2.6.2"
  }
}
